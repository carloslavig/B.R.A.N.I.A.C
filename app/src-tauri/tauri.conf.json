{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BRANIAC",
  "version": "0.2.0",
  "identifier": "com.carloslavig.braniac",
  "build": {
    "frontendDist": "../ui-loader"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/braniac-core"],
    "shortDescription": "Assistente de IA pessoal",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
